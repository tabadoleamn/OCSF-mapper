{
  "source_name": "sysmon_process",
  "display_name": "Sysmon",
  "vendor": "Microsoft",
  "priority": "critical",
  "description": "Sysmon Event ID 1 (process creation) and 5 (process termination).",
  "mapping_version": "1.0.0",
  "parser": "json",
  "routing": {
    "field": "$._ocsf_route",
    "rules": [
      {
        "matches": [
          "process_activity"
        ],
        "class": "process_activity"
      },
      {
        "matches": [
          "file_activity"
        ],
        "class": "file_activity"
      },
      {
        "matches": [
          "network_activity"
        ],
        "class": "network_activity"
      },
      {
        "matches": [
          "windows_service_activity"
        ],
        "class": "windows_service_activity"
      },
      {
        "matches": [
          "kernel_extension_activity"
        ],
        "class": "kernel_extension_activity"
      },
      {
        "matches": [
          "module_activity"
        ],
        "class": "module_activity"
      },
      {
        "matches": [
          "windows_resource_activity"
        ],
        "class": "windows_resource_activity"
      },
      {
        "matches": [
          "registry_key_activity"
        ],
        "class": "registry_key_activity"
      },
      {
        "matches": [
          "registry_value_activity"
        ],
        "class": "registry_value_activity"
      },
      {
        "matches": [
          "dns_activity"
        ],
        "class": "dns_activity"
      },
      {
        "matches": [
          "clipboard_activity"
        ],
        "class": "clipboard_activity"
      },
      {
        "matches": [
          "application_error"
        ],
        "class": "application_error"
      },
      {
        "default": true,
        "class": "base_event"
      }
    ]
  },
  "classes": {
    "process_activity": {
      "mapping": {
        "metadata.version": {
          "const": "1.9.0-dev"
        },
        "metadata.product.name": {
          "const": "Sysmon"
        },
        "metadata.product.vendor_name": {
          "const": "Microsoft"
        },
        "metadata.logged_time": {
          "sysmon_collector_logged_time": "$"
        },
        "metadata.uid": {
          "path": "$.id"
        },
        "metadata.original_event_uid": {
          "to_string": "$.RecordNumber"
        },
        "metadata.event_code": {
          "to_string": "$.EventID"
        },
        "metadata.log_source": {
          "path": "$.Channel"
        },
        "metadata.log_provider": {
          "path": "$.SourceName"
        },
        "metadata.original_time": {
          "path": "$.UtcTime"
        },
        "metadata.log_level": {
          "path": "$.EventType"
        },
        "time": {
          "sysmon_utc_time": "$.UtcTime"
        },
        "category_uid": {
          "const": 1
        },
        "category_name": {
          "const": "System Activity"
        },
        "class_uid": {
          "const": 1007
        },
        "class_name": {
          "const": "Process Activity"
        },
        "activity_id": {
          "lookup": "$.EventID",
          "table": {
            "1": 1,
            "5": 2,
            "8": 4,
            "10": 3,
            "25": 4
          },
          "default": 0
        },
        "activity_name": {
          "lookup": "$.EventID",
          "table": {
            "1": "Launch",
            "5": "Terminate",
            "8": "Inject",
            "10": "Open",
            "25": "Inject"
          },
          "default": "Unknown"
        },
        "type_uid": {
          "expr": "class_uid * 100 + activity_id"
        },
        "severity_id": {
          "lookup": "$.Severity",
          "table": {
            "INFO": 1
          },
          "default": 99
        },
        "severity": {
          "sysmon_severity_text": "$.Severity"
        },
        "status_id": {
          "sysmon_status_id": "$.Status"
        },
        "status": {
          "sysmon_status_text": "$.Status"
        },
        "device.hostname": {
          "path": "$.Hostname"
        },
        "device.type_id": {
          "const": 5
        },
        "device.type": {
          "const": "to be asked from cyebr group"
        },
        "device.ip": {
          "path": "$.host_ip"
        },
        "process.pid": {
          "int": "$.ProcessId"
        },
        "process.uid": {
          "path": "$.ProcessGuid"
        },
        "process.name": {
          "windows_basename": "$.Image"
        },
        "process.file.name": {
          "windows_basename": "$.Image"
        },
        "process.file.path": {
          "path": "$.Image"
        },
        "process.file.internal_name": {
          "path": "$.OriginalFileName"
        },
        "process.user": {
          "windows_domain_user": "$.User"
        },
        "process.cmd_line": {
          "path": "$.CommandLine"
        },
        "process.working_directory": {
          "path": "$.CurrentDirectory"
        },
        "process.integrity": {
          "path": "$.IntegrityLevel"
        },
        "process.integrity_id": {
          "lookup": "$.IntegrityLevel",
          "table": {
            "Unknown": 0,
            "Untrusted": 1,
            "Low": 2,
            "Medium": 3,
            "High": 4,
            "System": 5,
            "Protected": 6,
            "Other": 99
          }
        },
        "process.parent_process.pid": {
          "int": "$.ParentProcessId"
        },
        "process.parent_process.uid": {
          "path": "$.ParentProcessGuid"
        },
        "process.parent_process.name": {
          "windows_basename": "$.ParentImage"
        },
        "process.parent_process.path": {
          "path": "$.ParentImage"
        },
        "process.parent_process.user": {
          "windows_domain_user": "$.ParentUser"
        },
        "process.parent_process.cmd_line": {
          "path": "$.ParentCommandLine"
        },
        "actor.process.cmd_line": {
          "path": "$.ParentCommandLine"
        },
        "actor.process.name": {
          "windows_basename": "$.ParentImage"
        },
        "actor.process.pid": {
          "int": "$.ParentProcessId"
        },
        "process.user.name": {
          "path": "$.User"
        },
        "process.file.hashes": {
          "sysmon_hashes_to_ocsf_fingerprints": "$.Hashes"
        },
        "process.file.version": {
          "path": "$.FileVersion"
        },
        "process.file.desc": {
          "path": "$.Description"
        },
        "process.file.company_name": {
          "path": "$.Company"
        },
        "process.file.product.name": {
          "path": "$.Product"
        },
        "process.file.type_id": {
          "const": 8
        },
        "actor.user.name": {
          "path": "$.User"
        },
        "actor.process.path": {
          "path": "$.ParentImage"
        },
        "actor.process.uid": {
          "path": "$.ParentProcessGuid"
        },
        "actor.user": {
          "windows_domain_user": "$.ParentUser"
        }
      }
    },
